<svg xmlns="http://www.w3.org/2000/svg" width="1400" height="1400" viewBox="0 0 1400 1400" role="img" aria-labelledby="title desc">
  <title id="title">CARE-IT Core Visual Architecture</title>
  <desc id="desc">Production-ready CARE-IT diagram with an inner principle compass, a middle ring of management areas, and an outer clinical system constellation.</desc>

  <defs>
    <style>
      :root {
        --bg: #f7f9fc;
        --ink: #18324a;
        --muted: #5d7387;
        --line: #d7e0ea;
        --line-strong: #9db0c2;
        --white: #ffffff;
        --ma1: #2d8ca3;
        --ma2: #356fbe;
        --ma3: #7a59b5;
        --ma4: #2d4f74;
        --ma5: #d88a2b;
        --ma6: #5c9e4a;
        --p1: #d94b4b;
        --p2: #4a79c7;
        --p3: #8b66c4;
        --p4: #4f9aa3;
        --p5: #2d4f74;
        --p6: #d88a2b;
        --p7: #6aa84f;
        --p8: #5f7fa6;
      }

      .bg { fill: var(--bg); }
      .title { font: 700 42px Inter, Arial, sans-serif; fill: var(--ink); letter-spacing: 0.2px; }
      .subtitle { font: 500 21px Inter, Arial, sans-serif; fill: var(--muted); }
      .section-label { font: 700 16px Inter, Arial, sans-serif; fill: var(--muted); letter-spacing: 1.3px; text-transform: uppercase; }
      .ring-title { font: 700 20px Inter, Arial, sans-serif; fill: var(--muted); letter-spacing: 0.8px; }
      .center-title { font: 800 34px Inter, Arial, sans-serif; fill: var(--ink); letter-spacing: 0.8px; }
      .center-sub { font: 600 18px Inter, Arial, sans-serif; fill: var(--muted); }
      .axis-label { font: 700 18px Inter, Arial, sans-serif; fill: var(--muted); letter-spacing: 0.5px; }
      .ma-text { font: 700 20px Inter, Arial, sans-serif; fill: #ffffff; letter-spacing: 0.3px; text-anchor: middle; }
      .ma-id { font: 700 14px Inter, Arial, sans-serif; fill: rgba(255,255,255,0.85); text-anchor: middle; letter-spacing: 1px; }
      .node-id { font: 800 18px Inter, Arial, sans-serif; fill: #ffffff; text-anchor: middle; }
      .node-label { font: 700 14px Inter, Arial, sans-serif; fill: #ffffff; text-anchor: middle; }
      .legend-head { font: 700 18px Inter, Arial, sans-serif; fill: var(--ink); }
      .legend-text { font: 500 15px Inter, Arial, sans-serif; fill: var(--muted); }
      .outline { fill: none; stroke: var(--line); stroke-width: 2.5; }
      .soft { fill: none; stroke: var(--line); stroke-width: 1.8; }
      .soft-dash { fill: none; stroke: var(--line-strong); stroke-width: 2.2; stroke-dasharray: 8 10; }
      .axis { stroke: var(--line-strong); stroke-width: 4; }
      .axis-strong { stroke: var(--muted); stroke-width: 5; }
      .center-circle { fill: var(--white); stroke: var(--line-strong); stroke-width: 3; }
      .halo { fill: var(--white); opacity: 0.82; }
      .legend-card { fill: rgba(255,255,255,0.92); stroke: var(--line); stroke-width: 2; }
      .device { fill: #ffffff; stroke: var(--line-strong); stroke-width: 2; }
      .device-accent { fill: #eaf1f7; stroke: var(--line-strong); stroke-width: 2; }
      .constellation-line { stroke: #b8c6d4; stroke-width: 2; fill: none; }
      .constellation-dot { fill: #c2cfdb; }
    </style>

    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="18" flood-color="#a9b7c6" flood-opacity="0.18"/>
    </filter>

    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#5d7387"/>
    </marker>

    <!-- Management area paths -->
    <path id="ma1" d="M 339.474 440 A 430 430 0 0 1 548.362 293.592"/>
    <path id="ma2" d="M 575.185 285.277 A 430 430 0 0 1 824.815 285.277"/>
    <path id="ma3" d="M 851.638 293.592 A 430 430 0 0 1 1060.526 440"/>
    <path id="ma4" d="M 1082.346 457.95 A 430 430 0 0 1 1054.14 822.657"/>
    <path id="ma5" d="M 1034.468 842.731 A 430 430 0 0 1 730.97 997.726"/>
    <path id="ma6" d="M 699.03 997.726 A 430 430 0 0 1 365.532 842.731"/>
  </defs>

  <rect class="bg" x="0" y="0" width="1400" height="1400"/>

  <text x="700" y="88" text-anchor="middle" class="title">CARE-IT Core Visual Architecture</text>
  <text x="700" y="122" text-anchor="middle" class="subtitle">Principles guide decisions · Management Areas structure governance · System Constellations represent operational reality</text>

  <!-- Outer framework -->
  <g filter="url(#shadow)">
    <circle cx="700" cy="700" r="520" class="halo"/>
  </g>
  <circle cx="700" cy="700" r="520" class="outline"/>
  <circle cx="700" cy="700" r="460" class="soft"/>
  <circle cx="700" cy="700" r="320" class="soft"/>
  <circle cx="700" cy="700" r="205" class="soft"/>

  <!-- Management area ring -->
  <g filter="url(#shadow)">
    <path d="M 325.589 488.5 A 430 430 0 0 1 560.4 277.708 L 589.665 359.843 A 343 343 0 0 0 402.184 528.477 Z" fill="var(--ma1)"/>
    <path d="M 560.4 277.708 A 430 430 0 0 1 839.6 277.708 L 811.795 360.349 A 343 343 0 0 0 588.205 360.349 Z" fill="var(--ma2)"/>
    <path d="M 839.6 277.708 A 430 430 0 0 1 1074.411 488.5 L 997.816 528.477 A 343 343 0 0 0 810.335 359.843 Z" fill="var(--ma3)"/>
    <path d="M 1090.158 525.453 A 430 430 0 0 1 1070.846 849.911 L 994.565 809.348 A 343 343 0 0 0 1009.995 550.182 Z" fill="var(--ma4)"/>
    <path d="M 1053.997 879.986 A 430 430 0 0 1 739.949 1128.192 L 731.913 1040.591 A 343 343 0 0 0 983.152 841.986 Z" fill="var(--ma5)"/>
    <path d="M 660.051 1128.192 A 430 430 0 0 1 346.003 879.986 L 416.848 841.986 A 343 343 0 0 0 668.087 1040.591 Z" fill="var(--ma6)"/>
  </g>

  <!-- Segment dividers -->
  <g>
    <line x1="589.665" y1="359.843" x2="560.4" y2="277.708" stroke="#ffffff" stroke-width="8"/>
    <line x1="811.795" y1="360.349" x2="839.6" y2="277.708" stroke="#ffffff" stroke-width="8"/>
    <line x1="997.816" y1="528.477" x2="1074.411" y2="488.5" stroke="#ffffff" stroke-width="8"/>
    <line x1="994.565" y1="809.348" x2="1070.846" y2="849.911" stroke="#ffffff" stroke-width="8"/>
    <line x1="731.913" y1="1040.591" x2="739.949" y2="1128.192" stroke="#ffffff" stroke-width="8"/>
    <line x1="416.848" y1="841.986" x2="346.003" y2="879.986" stroke="#ffffff" stroke-width="8"/>
  </g>

  <!-- Management area labels -->
  <text x="700" y="242" text-anchor="middle" class="ring-title">CARE-IT Management Areas</text>

  <text class="ma-id"><textPath href="#ma1" startOffset="50%">MA1</textPath></text>
  <text class="ma-text"><textPath href="#ma1" startOffset="50%">Clinical Value</textPath></text>

  <text class="ma-id"><textPath href="#ma2" startOffset="50%">MA2</textPath></text>
  <text class="ma-text"><textPath href="#ma2" startOffset="50%">System Architecture</textPath></text>

  <text class="ma-id"><textPath href="#ma3" startOffset="50%">MA3</textPath></text>
  <text class="ma-text"><textPath href="#ma3" startOffset="50%">Responsibilities</textPath></text>

  <text class="ma-id"><textPath href="#ma4" startOffset="50%">MA4</textPath></text>
  <text class="ma-text"><textPath href="#ma4" startOffset="50%">Risk &amp; Patient Safety</textPath></text>

  <text class="ma-id"><textPath href="#ma5" startOffset="50%">MA5</textPath></text>
  <text class="ma-text"><textPath href="#ma5" startOffset="50%">Lifecycle &amp; Operations</textPath></text>

  <text class="ma-id"><textPath href="#ma6" startOffset="50%">MA6</textPath></text>
  <text class="ma-text"><textPath href="#ma6" startOffset="50%">Innovation</textPath></text>

  <!-- Principle compass -->
  <text x="700" y="405" text-anchor="middle" class="section-label">CARE-IT Principles</text>

  <line x1="700" y1="500" x2="700" y2="900" class="axis-strong" marker-start="url(#arrow)" marker-end="url(#arrow)"/>
  <line x1="500" y1="700" x2="900" y2="700" class="axis-strong" marker-start="url(#arrow)" marker-end="url(#arrow)"/>
  <line x1="560" y1="560" x2="840" y2="840" class="soft-dash"/>
  <line x1="840" y1="560" x2="560" y2="840" class="soft-dash"/>

  <text x="700" y="470" text-anchor="middle" class="axis-label">Decision Integrity</text>
  <text x="930" y="705" class="axis-label">Care Impact</text>
  <text x="700" y="945" text-anchor="middle" class="axis-label">Time &amp; Evolution</text>
  <text x="355" y="705" text-anchor="middle" class="axis-label">Governance Clarity</text>

  <circle cx="700" cy="700" r="110" class="center-circle"/>
  <text x="700" y="690" text-anchor="middle" class="center-title">CARE-IT</text>
  <text x="700" y="718" text-anchor="middle" class="center-sub">Principle Compass</text>

  <!-- Principle nodes -->
  <g>
    <circle cx="700" cy="520" r="48" fill="var(--p5)"/>
    <text x="700" y="516" class="node-id">P5</text>
    <text x="700" y="536" class="node-label">Patient Safety</text>
  </g>
  <g>
    <circle cx="700" cy="880" r="48" fill="var(--p8)"/>
    <text x="700" y="876" class="node-id">P8</text>
    <text x="700" y="896" class="node-label">Innovation Capability</text>
  </g>
  <g>
    <circle cx="520" cy="700" r="48" fill="var(--p2)"/>
    <text x="520" y="696" class="node-id">P2</text>
    <text x="520" y="716" class="node-label">System Responsibility</text>
  </g>
  <g>
    <circle cx="880" cy="700" r="48" fill="var(--p7)"/>
    <text x="880" y="696" class="node-id">P7</text>
    <text x="880" y="716" class="node-label">Information Integrity</text>
  </g>
  <g>
    <circle cx="573" cy="573" r="44" fill="var(--p4)"/>
    <text x="573" y="569" class="node-id">P4</text>
    <text x="573" y="589" class="node-label">Shared Understanding</text>
  </g>
  <g>
    <circle cx="827" cy="573" r="44" fill="var(--p3)"/>
    <text x="827" y="569" class="node-id">P3</text>
    <text x="827" y="589" class="node-label">Responsibility Transparency</text>
  </g>
  <g>
    <circle cx="573" cy="827" r="44" fill="var(--p1)"/>
    <text x="573" y="823" class="node-id">P1</text>
    <text x="573" y="843" class="node-label">Clinical Effectiveness</text>
  </g>
  <g>
    <circle cx="827" cy="827" r="44" fill="var(--p6)"/>
    <text x="827" y="823" class="node-id">P6</text>
    <text x="827" y="843" class="node-label">Lifecycle Sustainability</text>
  </g>

  <!-- Outer constellation -->
  <text x="700" y="1185" text-anchor="middle" class="section-label">Clinical System Constellation</text>

  <g opacity="0.98">
    <path class="constellation-line" d="M 230 1065 C 355 1035, 450 1048, 560 1078 S 790 1125, 965 1088 S 1125 1060, 1190 1082"/>
    <path class="constellation-line" d="M 242 1110 C 360 1080, 470 1116, 612 1100 S 825 1068, 996 1112 S 1122 1138, 1178 1118"/>
    <path class="constellation-line" d="M 278 1148 C 420 1164, 532 1142, 662 1168 S 922 1196, 1126 1158"/>

    <circle cx="244" cy="1094" r="8" class="constellation-dot"/>
    <circle cx="316" cy="1127" r="7" class="constellation-dot"/>
    <circle cx="408" cy="1083" r="8" class="constellation-dot"/>
    <circle cx="517" cy="1140" r="7" class="constellation-dot"/>
    <circle cx="651" cy="1112" r="9" class="constellation-dot"/>
    <circle cx="776" cy="1152" r="8" class="constellation-dot"/>
    <circle cx="902" cy="1094" r="7" class="constellation-dot"/>
    <circle cx="1018" cy="1138" r="8" class="constellation-dot"/>
    <circle cx="1112" cy="1088" r="8" class="constellation-dot"/>
    <circle cx="1182" cy="1122" r="7" class="constellation-dot"/>

    <!-- Hospital -->
    <g transform="translate(305 1016)">
      <rect x="0" y="20" width="72" height="58" rx="8" class="device"/>
      <rect x="20" y="0" width="32" height="24" rx="4" class="device-accent"/>
      <rect x="14" y="38" width="12" height="12" class="device-accent"/>
      <rect x="30" y="38" width="12" height="12" class="device-accent"/>
      <rect x="46" y="38" width="12" height="12" class="device-accent"/>
      <rect x="30" y="56" width="12" height="22" class="device-accent"/>
    </g>

    <!-- Monitor -->
    <g transform="translate(468 1028)">
      <rect x="0" y="0" width="74" height="50" rx="8" class="device"/>
      <rect x="8" y="8" width="58" height="34" rx="4" class="device-accent"/>
      <rect x="28" y="50" width="18" height="12" class="device"/>
      <rect x="18" y="62" width="38" height="8" rx="4" class="device"/>
    </g>

    <!-- Integration engine -->
    <g transform="translate(622 1018)">
      <rect x="0" y="0" width="44" height="88" rx="10" class="device"/>
      <line x1="10" y1="24" x2="34" y2="24" class="constellation-line"/>
      <line x1="10" y1="44" x2="34" y2="44" class="constellation-line"/>
      <line x1="10" y1="64" x2="34" y2="64" class="constellation-line"/>
      <rect x="8" y="10" width="28" height="8" rx="4" class="device-accent"/>
    </g>

    <!-- Workstation -->
    <g transform="translate(748 1024)">
      <rect x="0" y="0" width="88" height="54" rx="8" class="device"/>
      <rect x="8" y="8" width="72" height="38" rx="4" class="device-accent"/>
      <circle cx="44" cy="27" r="10" fill="#9ec2e4"/>
      <line x1="44" y1="27" x2="60" y2="17" class="constellation-line"/>
      <rect x="35" y="54" width="18" height="10" class="device"/>
      <rect x="22" y="64" width="44" height="8" rx="4" class="device"/>
    </g>

    <!-- Tablet / mobile -->
    <g transform="translate(903 1040)">
      <rect x="0" y="0" width="34" height="62" rx="8" class="device"/>
      <rect x="6" y="10" width="22" height="38" rx="4" class="device-accent"/>
      <circle cx="17" cy="53" r="2.5" fill="#9db0c2"/>
    </g>

    <!-- Database -->
    <g transform="translate(1028 1018)">
      <ellipse cx="36" cy="12" rx="34" ry="12" class="device"/>
      <rect x="2" y="12" width="68" height="58" class="device"/>
      <ellipse cx="36" cy="70" rx="34" ry="12" class="device"/>
      <line x1="8" y1="30" x2="64" y2="30" class="constellation-line"/>
      <line x1="8" y1="48" x2="64" y2="48" class="constellation-line"/>
    </g>
  </g>

  <!-- Legend -->
  <g transform="translate(88 170)">
    <rect width="260" height="178" rx="20" class="legend-card" filter="url(#shadow)"/>
    <text x="24" y="36" class="legend-head">Visual Logic</text>
    <text x="24" y="68" class="legend-text">Principles = normative orientation</text>
    <text x="24" y="96" class="legend-text">Management Areas = governance spaces</text>
    <text x="24" y="124" class="legend-text">System Constellation = operational reality</text>
    <text x="24" y="156" class="legend-text">Use in slides, website, papers, and workshops</text>
  </g>

  <g transform="translate(1048 170)">
    <rect width="264" height="178" rx="20" class="legend-card" filter="url(#shadow)"/>
    <text x="24" y="36" class="legend-head">Naming Pattern</text>
    <text x="24" y="68" class="legend-text">P = foundational principle</text>
    <text x="24" y="96" class="legend-text">MA = management area</text>
    <text x="24" y="124" class="legend-text">Short labels for visualization</text>
    <text x="24" y="156" class="legend-text">Expanded labels in legend or publication text</text>
  </g>

  <!-- Footer -->
  <text x="700" y="1326" text-anchor="middle" class="subtitle">Production-ready concept SVG · CARE-IT visual language draft</text>
</svg>